@startuml
' --- Estilo Astah Premium: Sincronia Total com Imagem de Referência ---
mainframe uc UseCase Diagram Nex_TI

left to right direction

' Configurações Visuais
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 60
skinparam shadowing false

' Estilos de Cores (Fiel ao Astah)
skinparam usecase {
    BackgroundColor #FFFEE1
    BorderColor Black
}
skinparam actor {
    BackgroundColor White
    BorderColor Black
}

' Declaração dos Atores (Coluna Esquerda)
actor "MD_Usuario" as Usuario
actor "MD_Admin" as Admin
actor "MD_Tutor" as Tutor
actor "MD_Aluno" as Aluno

' Herança (Atores em árvore vertical no Astah)
Admin -up-|> Usuario
Tutor -up-|> Usuario
Aluno -up-|> Usuario

' Ator IA (Lado Direito)
actor "MD_Agente Especialista (IA)" as IA

' Caixa central do sistema
rectangle "Sistema Nex_TI" {
    
    ' Coluna única de casos de uso para evitar largura excessiva
    usecase "Realizar login" as UC_Login
    usecase "Cadastrar Novo Usuário" as UC_Cadastrar
    usecase "Realizar Teste de Nivelamento" as UC_Teste
    usecase "Gerenciar Perfis e Acessos" as UC_GerenciarPerfis
    usecase "Gerenciar Conteúdo das Cartas" as UC_GerenciarConteudo
    usecase "Acompanhar Desempenho dos Usuários" as UC_Acompanhar
    usecase "Escalar Dúvida para Tutor" as UC_Escalar
    usecase "Consultar Agente Especialista" as UC_Consultar
    usecase "Estudar Flashcards" as UC_Estudar
    usecase "Criar Flashcards" as UC_Criar
    usecase "Realizar Simulado ENADE" as UC_Simulado
    usecase "Atribuir XP e Moedas" as UC_Atribuir
    usecase "Desbloquear Fases e Módulos" as UC_Desbloquear
    usecase "Visualizar Painel de Progresso" as UC_Painel
    usecase "Ajustar Acessibilidade" as UC_Acessibilidade

    ' Ocultamos o empilhamento manual pois o PlantUML em 'left to right direction'
    ' transforma -[hidden]down- em deslocamento horizontal, esticando a caixa.
    ' O algoritmo nativo distribuirá melhor os casos de uso baseado nas ligações reais.
}

' Relacionamentos de Atores
Usuario -- UC_Login
Usuario -- UC_Acessibilidade
Admin -- UC_GerenciarPerfis
Tutor -- UC_GerenciarConteudo
Tutor -- UC_Acompanhar
Tutor -- UC_Escalar
Aluno -- UC_Consultar
Aluno -- UC_Estudar
Aluno -- UC_Simulado
Aluno -- UC_Desbloquear
Aluno -- UC_Painel

' IA
IA -- UC_Consultar

' Relacionamentos Internos (Tracejados)
UC_Cadastrar ..> UC_Login : <<extend>>
UC_Teste ..> UC_Login : <<extend>>
UC_Escalar ..> UC_Consultar : <<extend>>
UC_Criar ..> UC_Estudar : <<extend>>
UC_Estudar ..> UC_Atribuir : <<include>>
UC_Simulado ..> UC_Atribuir : <<include>>

@enduml