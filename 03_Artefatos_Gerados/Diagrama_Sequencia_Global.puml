@startuml
' --- Configurações Estilo Astah ---
skinparam backgroundColor white
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam sequenceLogicColor #000000

skinparam participant {
    BackgroundColor #FFFEE1
    BorderColor #000000
}

center header
<b>Sistema Nex_TI - Fluxo Global de Operação</b>
endheader

actor "Aluno" as User
participant ":Interface_Principal" as UI <<Fronteira>>
participant ":Controlador_Geral" as CTRL <<Controle>>
participant ":Motor_SM2" as SM2 <<Controle>>
participant ":Agente_IA" as IA <<Controle>>
participant ":Aluno" as EntityAluno <<Entidade>>
participant ":Flashcard_SM2" as Flashcard <<Entidade>>

== 1. Autenticação e Carregamento ==

autonumber
User -> UI : realizarLogin(credenciais)
activate UI

UI -> CTRL : validarAcesso(credenciais)
activate CTRL

CTRL -> EntityAluno : verificarCredenciais()
activate EntityAluno
EntityAluno -->> CTRL : usuarioAutenticado
deactivate EntityAluno

CTRL -->> UI : loginSucesso()
deactivate CTRL

UI -->> User : exibeDashboard()
deactivate UI

== 2. Ciclo de Estudo (Algoritmo SM-2) ==

User -> UI : iniciarSessaoEstudo()
activate UI

UI -> CTRL : buscarProximasRevisoes()
activate CTRL

CTRL -> Flashcard : filtrarCartasVencidas(dataAtual)
activate Flashcard
Flashcard -->> CTRL : listaDeFlashcards
deactivate Flashcard

CTRL -->> UI : exibirPrimeiraCarta(pergunta)
deactivate CTRL

User -> UI : informarFeedback(facilidade)
activate UI

UI -> CTRL : processarResposta(facilidade)
activate CTRL

CTRL -> SM2 : calcularNovoIntervalo(facilidade)
activate SM2
SM2 -->> CTRL : novaDataRevisao
deactivate SM2

CTRL -> Flashcard : atualizarData(novaDataRevisao)
activate Flashcard
Flashcard -->> CTRL : confirmacao
deactivate Flashcard

CTRL -> CTRL : atribuirGamificacao(XP)
note right: Atribui XP e Moedas\nbaseado na performance

CTRL -->> UI : feedbackSucesso(XP_Ganhado)
deactivate CTRL

UI -->> User : animacaoProgresso()
deactivate UI

== 3. Suporte Inteligente (IA) ==

User -> UI : solicitarAjudaIA(duvida)
activate UI

UI -> CTRL : processarDuvida(duvida)
activate CTRL

CTRL -> IA : analisarDuvida(duvida)
activate IA
IA -> IA : gerarExplicacaoContextual()
IA -->> CTRL : respostaSugerida
deactivate IA

CTRL -->> UI : exibirRespostaIA()
deactivate CTRL

UI -->> User : exibeExplicacao()
deactivate UI

@enduml

